# Chave da Riot Developer API.
# Sem essa variável o site funciona normalmente: apenas omite o V/D.
# Em produção, cadastre como RIOT_API_KEY no painel da Vercel — nunca no código.
RIOT_API_KEY=

# Credenciais do app no console da Twitch (https://dev.twitch.tv/console/apps).
#
# Diferente da Kick, a Twitch não tem API pública sem autenticação: todo endpoint
# Helix exige token. Cadastre um app, copie o Client ID e o Client Secret e
# preencha abaixo. O "Client Type" do formulário tem de ser Confidential — sem o
# Client Secret não existe o fluxo Client Credentials, que é o que gera o token
# usado para consultar o status de live.
#
# O Client Type só pode ser escolhido na criação do app, então confira em
# "Manage" se o botão "Generate Client Secret" aparece: se não aparecer, o app
# foi criado como público e precisa ser refeito.
#
# O Client Secret é usado só no servidor. Nunca exponha em variável NEXT_PUBLIC_*
# nem chame a Helix direto do browser.
#
# Sem essas duas variáveis o site funciona normalmente: os canais da Twitch ficam
# todos offline e a Kick segue funcionando. Em produção, cadastre ambas no painel
# da Vercel.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
